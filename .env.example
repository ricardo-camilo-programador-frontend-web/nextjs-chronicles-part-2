# ── Public URLs (NEXT_PUBLIC_* prefix required for Next.js client-side access) ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PORTFOLIO_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_99FREELAS_URL=
NEXT_PUBLIC_WORKANA_URL=
NEXT_PUBLIC_BUYMEACOFFEE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_FIGMA_URL=
NEXT_PUBLIC_FIGMA_ORIGINAL_DESIGN=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_URL=

# ── Analytics & Tracking ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_COUNTER_DEV_ID=

# ── Adsterra Native Banner (um anuncio discreto antes do footer) ──
# Chaves vazias = nenhum anuncio renderizado. Configurar no Netlify
# (Site configuration -> Environment variables) e reimplantar.
# NATIVE_KEY: painel Adsterra -> Websites -> site -> Get Code (Native Banner).
# NATIVE_HOST: host do snippet sem https:// (ex.: plXXXX.effectivegatecpm.com).
# BANNER_*: opcionais (banner display substitui o Native, nunca um 2o slot).
# ENABLED=false desliga o slot; vazio = ligado so quando ha key.
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_HOST=
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_HOST=
NEXT_PUBLIC_ADSTERRA_ENABLED=

# ── Internal / Server-only (no prefix, not exposed to client) ──
PROJECT_TITLE=
PORT=3000
GOOGLE_SITE_VERIFICATION=
COUNTER_API_KEY=
